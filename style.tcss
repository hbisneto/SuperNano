$primary: #7c84ec;
$accent: #454990;
$background: #1F1F1F;
$surface: #141414;
$text: #ffffff;
$muted: #94a3b8;

* {
    scrollbar-background: #141414;
    scrollbar-color: #C3C3C380;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $primary;
}

#editor{
    height: 1fr;
    width: 100%;
    margin-right: 0;
    border: none;
    padding: 1;
}

#files {
    padding-top: 1;
    padding-left: 1;
    padding-right: 1;
}

#input_area {
    height: auto;
    width: 100%;
    background: #262626;
    border-top: tall $muted;
    padding: 0 1;
}

#input_area Input,
#input_area SearchBar {
    width: 100%;
}

#main {
    layout: vertical;
    height: 1fr;
    width: 1fr;
    background: $background;
}

#main > Vertical:last-child {   /* status */
    height: 1;
}

#path_container,
#search_container {
    height: auto;
    width: 100%;
    background: $surface;
    border-top: tall $muted;
    padding: 1 2;
    margin: 0;
}

#path_input,
#replace_input,
#search_input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    background: $background;
    color: $text;
    border: tall $muted;
}

#path_input:focus,
#replace_input:focus,
#search_input:focus {
    border: tall $primary;
}

#search_container SearchBar > #replace_input {
    margin-bottom: 0;
}

#sidebar {
    width: 35;
    background: #212529;
    border: none;
}

#status {
    height: 1;
    background: $accent;
    color: #FFFFFF;
    width: 100%;
    margin: 0;
    padding-left: 1;
}

#status.success {
    background: #22c55e;
}

#status.warning {
    background: #f59e0b;
}

#status.info {
    background: #0d6efd;
}

#status.error {
    background: #ef4444;
}

.title {
    background: #454990;
    color: $text;
    text-style: bold;
    text-align: center;
}

DirectoryTree {
    background: $surface;
    color: $text;
    scrollbar-gutter: stable;
}

DirectoryTree .folder {
    color: #22c55e;
    text-style: bold;
}

DirectoryTree .file {
    color: #60a5fa;
}

DirectoryTree .hidden {
    color: $muted;
    text-style: italic;
}

Footer {
    background: $background;
    color: $muted;
}

Header {
    background: $surface;
    color: $text;
}

Horizontal {}

Input {
    background: $background;
    color: $text;
    border: tall $muted;
}

Input:focus {
    border: tall $primary;
}

ListItem {
    color: $text;
}

ListItem.--highlight {
    background: $primary;
    color: $background;
}

ListItem:focus {
    background: $accent;
    color: $background;
}

ListView {}

Screen {
    background: $background;
    color: $text;
}

SearchBar {
    width: 100%;
    height: auto;
    padding: 0;
}

SearchBar.--visible {
    display: block;
}

TextArea {
    background: $background;
    color: #d1d5db;
    scrollbar-gutter: stable;
}

Vertical {}