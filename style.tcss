$primary: #3b82f6;
$accent: #22c55e;
$background: #1F1F1F;
$surface: #1F1F1F;
$text: #ffffff;
$muted: #94a3b8;

Screen {
    background: $background;
    color: $text;
}

Horizontal {}
Vertical {}

#sidebar {
    width: 30;
    background: $surface;
    border-right: tall $primary;
}

#main {
    layout: vertical;
    height: 100%;
    width: 1fr;
    background: $background;
}

.title {
    background: #454990;
    color: $text;
    text-style: bold;
    text-align: center;
}

#files {
    padding-top: 1;
    padding-left: 1;
    padding-right: 1;
}
ListView {}

ListItem {
    color: $text;
}

ListItem.--highlight {
    background: $primary;
    color: $background;
}

ListItem:focus {
    background: $accent;
    color: $background;
}

#editor {
    height: 1fr;
    width: 100%;
    margin-right: 0;
}

TextArea {
    background: $background;
    color: #d1d5db;
    scrollbar-gutter: stable;
}

#path_input {
    height: auto;
}

SearchBar {
    dock: bottom;
    height: 3;
    width: 100%;
    background: #262626;
    border-top: tall $muted;
    padding: 0 1;
    display: none;
}

SearchBar.--visible {
    display: block;
}

#search_input {
    width: 1fr;
}

#replace_input {
    width: 1fr;
}

Input {
    background: $background;
    color: $text;
    border: tall $muted;
}

Input:focus {
    border: tall $accent;
}

#status {
    background: $accent;
    color: $background;
    width: 1fr;
    margin-left: 0;
    margin-right: 1;
}

#status.success {
    background: #22c55e;
}

#status.warning {
    background: #f59e0b;
}

#status.info {
    background: #0d6efd;
}

#status.error {
    background: #ef4444;
}


Header {
    background: $surface;
    color: $text;
}

Footer {
    background: #454990;
    color: $muted;
}