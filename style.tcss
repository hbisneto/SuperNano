$primary: #3b82f6;
$accent: #22c55e;
$background: #1F1F1F;
$surface: #1F1F1F;
$text: #ffffff;
$muted: #94a3b8;

Screen {
    background: $background;
    color: $text;
}

Horizontal {}
Vertical {}

#sidebar {
    width: 50;
    background: $surface;
    border-right: tall $primary;
}

#main {
    width: 1fr;
    background: $background;
}

.title {
    background: #454990;
    color: $text;
    text-style: bold;
    text-align: center;
}

#files {}
ListView {}

ListItem {
    color: $text;
}

ListItem.--highlight {
    background: $primary;
    color: $background;
}

ListItem:focus {
    background: $accent;
    color: $background;
}

#editor {}

TextArea {
    background: $background;
    color: #d1d5db;
}

#path_input {}

Input {
    background: $background;
    color: $text;
    border: tall $muted;
}

Input:focus {
    border: tall $accent;
}

#status {
    background: $accent;
    color: $background;
}

#status.success {
    background: #22c55e;
}

#status.warning {
    background: #f59e0b;
}

#status.info {
    background: #0d6efd;
}

#status.error {
    background: #ef4444;
}


Header {
    background: $surface;
    color: $text;
}

Footer {
    background: #454990;
    color: $muted;
}